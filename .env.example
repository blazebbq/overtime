# Database
DATABASE_URL="postgresql://fitfinish:fitfinish_dev_password@localhost:5432/fitfinish?schema=public"

# NextAuth
NEXTAUTH_SECRET="change-this-to-a-random-secret-in-production"
NEXTAUTH_URL="http://localhost:3000"

# S3-compatible Object Storage (DigitalOcean Spaces compatible)
S3_ENDPOINT="https://nyc3.digitaloceanspaces.com"
S3_REGION="nyc3"
S3_BUCKET="fitfinish-uploads"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
S3_PUBLIC_URL="https://fitfinish-uploads.nyc3.digitaloceanspaces.com"

# Optional: For local development, you can use MinIO instead
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"
# S3_BUCKET="fitfinish"
# S3_ACCESS_KEY_ID="minioadmin"
# S3_SECRET_ACCESS_KEY="minioadmin"
# S3_PUBLIC_URL="http://localhost:9000/fitfinish"
